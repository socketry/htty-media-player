<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>#{self.title}</title>
		<style>
			*, *::before, *::after {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html, body {
				width: 100%;
				height: 100%;
				background: #000;
				overflow: hidden;
			}

			audio, video {
				display: block;
				width: 100%;
				height: 100%;
				outline: none;
			}
		</style>
	</head>
	<body>
		<audio#{self.audio? ? " src=/media controls autoplay" : " hidden"}></audio>
		<video#{self.audio? ? " hidden" : " src=/media controls autoplay"}></video>
	</body>
</html>
