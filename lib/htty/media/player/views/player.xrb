<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>#{self.file.title}</title>
		<style>
			*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

			html, body {
				width: 100%; height: 100%;
				background: #000;
				overflow: hidden;
			}

			audio, video {
				display: block;
				width: 100%;
				height: 100%;
				outline: none;
			}

			#close {
				position: fixed;
				top: 20px;
				left: 20px;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 40px;
				height: 40px;
				border-radius: 50%;
				background: rgba(0, 0, 0, 0.65);
				border: 2px solid rgba(255, 255, 255, 0.35);
				color: #fff;
				font-size: 1.2rem;
				text-decoration: none;
				cursor: pointer;
				transition: background 0.15s, border-color 0.15s;
				backdrop-filter: blur(8px);
			}

			#close:hover {
				background: rgba(255, 255, 255, 0.18);
				border-color: rgba(255, 255, 255, 0.7);
			}
		</style>
	</head>
	<body>
		<a id="close" href="/" title="Back to playlist">&#x2715;</a>

<?r if self.file.audio? ?>
		<audio src="/media?index=#{self.index}" controls autoplay preload="metadata"></audio>
<?r else ?>
		<video src="/media?index=#{self.index}" controls autoplay preload="metadata"></video>
<?r end ?>

		<script>
			(function() {
				var index      = #{self.index};
				var nextIndex  = #{self.playlist.next_index(self.index)&.to_s || "null"};
				var media      = document.querySelector('audio') || document.querySelector('video');

				function persistLast(idx, callback) {
					fetch('/last?index=' + idx, {method: 'POST'})
						.then(callback)
						.catch(callback);
				}

				media.addEventListener('play', function() {
					persistLast(index, function() {});
				});

				media.addEventListener('ended', function() {
					if (nextIndex !== null && nextIndex !== undefined) {
						persistLast(nextIndex, function() {
							window.location.href = '/player?index=' + nextIndex;
						});
					} else {
						persistLast(index, function() {
							window.location.href = '/';
						});
					}
				});
			})();
		</script>
	</body>
</html>
