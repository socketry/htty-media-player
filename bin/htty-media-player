#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the MIT License.
# Copyright, 2026, by Samuel Williams.

require "async/htty"
require_relative "../lib/htty/media/player"

include HTTY::Media::Player

playlist = if ARGV.empty?
	Playlist.from_directory(Dir.pwd)
elsif ARGV.size == 1 && File.directory?(ARGV.first)
	Playlist.from_directory(ARGV.first)
else
	missing = ARGV.reject { |p| File.exist?(p) }
	if missing.any?
		$stderr.puts "Error: File(s) not found: #{missing.join(", ")}"
		exit 1
	end
	Playlist.from_paths(ARGV)
end

if playlist.files.empty?
	$stderr.puts "No supported media files found."
	exit 1
end

$stderr.puts "Loading metadata (ffprobe)…"
playlist.load_metadata!

app = Application.new(playlist)

Async::HTTY::Server.open(app)
